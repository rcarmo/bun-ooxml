      "testId": "bun:tests/unit/docx-revision-properties.test.ts:opt-in run-property profile resolves exact current or saved properties and text in all seven reachable stories through path reopen",
      "status": "partial",
      "scenarioIds": [
        "@id-docx-run-property-revisions-roundtrip"
      ],
      "caseKeys": [],
      "assertions": [
        "expect(report.unsupported).toEqual([])",
        "expect(report.revisions).toHaveLength(21)",
        "expect(report.revisions.filter(r=>r.kind==='run-properties').map(r=>[r.part,r.id,r.author,r.text])).toEqual(stories.map(part=>[part,'80','Editor','Stable']))",
        "expect(p.toBytes()).toEqual(source)",
        "expect(receipt).toEqual({resolved:21,changedParts:stories})",
        "expect(inspect(read)).toEqual({revisions:[],unsupported:[]})",
        "expect(xml).toContain(action==='accept'?'<w:rPr>'+current+'</w:rPr>':'<w:rPr>'+previous+'</w:rPr>')",
        "expect(xml).toBe(noProps.text(part))",
        "expect(elements(parseXml(xml),'t',W).map(t=>t.text).join('')).toContain(action==='accept'?'modernized.':'historic.')",
        "expect(xml).not.toContain('rPrChange')",
        "expect(await Bun.file(src).bytes()).toEqual(Uint8Array.from(source))",
        "expect(resolve(read,action)).toEqual({resolved:0,changedParts:[]})",
        "expect(read.toBytes()).toEqual(before)"
      ],
      "outcomes": [
        "Twenty-one revisions across seven stories resolve with exact receipt, old/current properties, path reopen, source custody and repeated no-op."
      ],
      "gaps": [
        "Native comparison package uses the text resolver for text-only expectations; shared wrapper independently builds full expected XML."
      ]
    },
