      "caseKeys": [],
      "assertions": [
        "expect(r.unsupported).toEqual([])",
        "expect(r.revisions).toHaveLength(35)",
        "expect(r.revisions.filter(r=>r.kind==='move-from'||r.kind==='move-to')).toEqual(parts.flatMap(part=>[{part,id:'101',kind:'move-from',author:'Reviewer',date:'2026-09-27T00:00:00Z',text:'Moved text'},{part,id:'103',kind:'move-to',author:'Reviewer',date:'2026-09-27T00:00:00Z',text:'Moved text'}]))",
        "expect(p.toBytes()).toEqual(source)",
        "expect(resolve(p,a)).toEqual({resolved:35,changedParts:parts})",
        "expect(read.text(part)).toBe(expected(base.text(part),a))",
        "expect(read.get(part)).toEqual(new TextEncoder().encode(expected(base.text(part),a)))",
        "expect(inspect(read)).toEqual({revisions:[],unsupported:[]})",
        "expect(await Bun.file(src).bytes()).toEqual(Uint8Array.from(source))",
        "expect(resolve(read,a)).toEqual({resolved:0,changedParts:[]})",
        "expect(read.toBytes()).toEqual(now)"
      ],
      "outcomes": [
        "Thirty-five revisions including exact move metadata resolve in seven stories with independent expected XML, encoded bytes, path reopen, source custody and repeat no-op."
      ],
      "gaps": [
        "Native generated variants only; no independent Word move resolver or producer coverage."
      ]
